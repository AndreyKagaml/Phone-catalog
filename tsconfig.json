{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,

    "forceConsistentCasingInFileNames": true,

    "sourceMap": false,

    "types": [
      "node",
      "cypress"
    ],

    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },

  "include": [
    "src"
  ],

  "exclude": [
    "node_modules"
  ]
}
